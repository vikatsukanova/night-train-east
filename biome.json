{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": [
			"*.json",
			"index.html",
			"vite.config.ts",
			"src/**",
			"tests/**",
			"scripts/**"
		]
	},
	"overrides": [
		{
			"includes": ["src/core/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"three": "Core must remain independent of three.js."
								},
								"patterns": [
									{
										"group": ["three/**"],
										"message": "Core must remain independent of three.js."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/npc/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"**/world",
											"**/world/**",
											"**/train",
											"**/train/**",
											"**/player",
											"**/player/**",
											"**/dialogue",
											"**/dialogue/**",
											"**/audio",
											"**/audio/**",
											"**/ui",
											"**/ui/**"
										],
										"message": "NPCs must receive other feature data at boot."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"src/world/**",
				"src/train/**",
				"src/player/**",
				"src/dialogue/**",
				"src/audio/**",
				"src/ui/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/npc", "**/npc/**"],
										"message": "Compose NPCs with other features at boot."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
